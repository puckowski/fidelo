# Local mode is the default and needs neither Redis nor AWS credentials.
FIDELO_MODE=local
FIDELO_OUTPUT_DIR=./generated
FIDELO_LOCAL_WORKERS=1
FIDELO_MAX_DURATION_SECONDS=180
FIDELO_JOB_TIMEOUT_SECONDS=3600
FIDELO_TOKENIZER_DIR=./latent_audio_tokenizer_out
FIDELO_PRIOR_DIR=./latent_audio_prior_out

# Production mode
# FIDELO_MODE=production
# FIDELO_REDIS_URL=redis://redis:6379/0
# FIDELO_QUEUE_NAME=fidelo-gpu
# FIDELO_S3_BUCKET=your-generation-bucket
# FIDELO_S3_PREFIX=generations
# AWS_REGION=us-east-1
# FIDELO_KEEP_LOCAL_OUTPUTS=false
